{
  "SX130x_conf": {
    "lorawan_public": true,
    "com_type": "USB",
    "com_path": "/dev/ttyACM0",
    "clksrc": 1,
    "antenna_gain": 0,
    "lbt_cfg": {
      "enable": true,
      "rssi_target": -80,
      "chan_cfg": [
        {
          "freq_hz": 922800000,
          "scan_time_us": 128
        },
        {
          "freq_hz": 922600000,
          "scan_time_us": 128
        },
        {
          "freq_hz": 922400000,
	  "scan_time_us": 128
        },
        {
          "freq_hz": 922200000,
          "scan_time_us": 128
        },
        {
          "freq_hz": 922000000,
          "scan_time_us": 128
        },
        {
          "freq_hz": 921800000,
          "scan_time_us": 128
        },
        {
          "freq_hz": 921600000,
          "scan_time_us": 128
        },
        {
          "freq_hz": 921400000,
          "scan_time_us": 128
        },
        {
          "freq_hz": 921200000,
          "scan_time_us": 128
        }
      ],
      "sx127x_rssi_offset": -4
    },
    "radio_0": {
      "enable": true,
      "type": "SX1250",
      "freq": 922500000,
      "rssi_offset": -215.4,
      "tx_enable": true,
      "tx_freq_min": 921200000,
      "tx_freq_max": 922800000,
      "tx_gain_lut": [
        {"rf_power": 0,  "pa_gain": 0, "pwr_idx": 0},
        {"rf_power": 12, "pa_gain": 0, "pwr_idx": 15},
        {"rf_power": 13, "pa_gain": 0, "pwr_idx": 16},
        {"rf_power": 14, "pa_gain": 0, "pwr_idx": 17},
        {"rf_power": 15, "pa_gain": 0, "pwr_idx": 19},
        {"rf_power": 16, "pa_gain": 0, "pwr_idx": 20},
        {"rf_power": 17, "pa_gain": 0, "pwr_idx": 22},
        {"rf_power": 18, "pa_gain": 1, "pwr_idx": 1},
        {"rf_power": 19, "pa_gain": 1, "pwr_idx": 2},
        {"rf_power": 20, "pa_gain": 1, "pwr_idx": 3},
        {"rf_power": 21, "pa_gain": 1, "pwr_idx": 4},
        {"rf_power": 22, "pa_gain": 1, "pwr_idx": 5},
        {"rf_power": 23, "pa_gain": 1, "pwr_idx": 6},
        {"rf_power": 24, "pa_gain": 1, "pwr_idx": 9}
      ]
    },
    "radio_1": {
      "enable": true,
      "type": "SX1250",
      "freq": 921700000,
      "rssi_offset": -215.4,
      "tx_enable": false,
      "tx_freq_min": 921200000,
      "tx_freq_max": 922800000
    },
    "chan_multiSF_All": {"spreading_factor_enable": [5, 6, 7, 8, 9, 10, 11, 12]},
    "chan_multiSF_0": {
      "enable": true,
      "radio": 0,
      "if": 300000
    },
    "chan_multiSF_1": {
      "enable": true,
      "radio": 0,
      "if": 100000
    },
    "chan_multiSF_2": {
      "enable": true,
      "radio": 0,
      "if": -100000
    },
    "chan_multiSF_3": {
      "enable": true,
      "radio": 0,
      "if": -300000
    },
    "chan_multiSF_4": {
      "enable": true,
      "radio": 1,
      "if": 300000
    },
    "chan_multiSF_5": {
      "enable": true,
      "radio": 1,
      "if": 100000
    },
    "chan_multiSF_6": {
      "enable": true,
      "radio": 1,
      "if": -100000
    },
    "chan_multiSF_7": {
      "enable": true,
      "radio": 1,
      "if": -300000
    },
    "chan_Lora_std": {
      "enable": true,
      "radio": 1,
      "if": -575000,
      "bandwidth": 250000,
      "spread_factor": 9,
      "_comment": "Repurposed as the shared Meshtastic RX-only 'LoRa service' channel (chain 8, see clusterduck/src/clusterduckd.c MESHTASTIC_LORA_STD_CHAIN). Bound to Meshtastic's MediumFast preset: 921700000 (radio_1 center) + (-575000) = 921125000 Hz / SF9 / 250kHz. Placed on radio_1 rather than radio_0 because MediumFast's frequency is far enough from radio_0's center (922500000 Hz) that its IF there would be -1375000 Hz, exceeding the SX1250 chan_Lora_std IF budget (|if|+bw/2 <= 800000 Hz, see loragw_hal.c rf_rx_bandwidth check). On radio_1, |if|+bw/2 = 575000+125000 = 700000 Hz (within budget), and this channel's occupied span (-700000 to -450000 Hz) does not overlap chan_multiSF_4..7 (nearest edge at -362500 Hz, ~87.5kHz clear). radio_1 is RX-only (tx_enable=false) which matches Meshtastic's RX-only role on this shared channel."
    },
    "chan_FSK": {
      "enable": true,
      "radio": 1,
      "if": 0,
      "bandwidth": 125000,
      "datarate": 50000
    }
  },
  "mqtt_conf": {
    "enabled": true,
    "server": "mqqt.server.com",
    "port": 1883,
    "client_id": "clusterduck-concentrator",
    "username": "",
    "password": "",
    "topics": {
      "publish": "hub/event",
      "subscribe": "hub/command",
      "response": "hub/response",
      "description": "publish: Gateway sends received packets | subscribe: Gateway receives commands | response: Gateway sends command acknowledgments"
    },
    "keepalive": 60,
    "use_tls": false,
    "ca_cert_file": ""
  }
}
